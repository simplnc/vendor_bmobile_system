// Browser
android_app_import {
    name: "DuckDuckGo",
    apk: "browser/duckduck.apk",
    privileged: false,
    certificate: "platform",
    dex_preopt: {
        enabled: false,
    },
}

// File Manager
android_app_import {
    name: "FossifyFileManager",
    apk: "filemanager/org.fossify.filemanager.apk",
    privileged: false,
    certificate: "platform",
    dex_preopt: {
        enabled: false,
    },
}

// Gallery
android_app_import {
    name: "FossifyGallery",
    apk: "gallery/org.fossify.gallery.apk",
    privileged: false,
    certificate: "platform",
    overrides: [
        "Gallery2",
        "Gallery",
        "Photos",
        "com.android.gallery3d",
        "org.lineageos.glimpse",
    ],
    dex_preopt: {
        enabled: false,
    },
}

// Image Toolbox
android_app_import {
    name: "ImageToolbox",
    apk: "imageToolbox/image-toolbox-3.4.0-alpha01-arm64-v8a.apk",
    privileged: false,
    certificate: "platform",
    dex_preopt: {
        enabled: false,
    },
}

// TapTap
android_app_import {
    name: "TapTap",
    apk: "taptap/TapTap-v1.6.2.apk",
    privileged: false,
    certificate: "platform",
    dex_preopt: {
        enabled: false,
    },
}

// Session Messenger
android_app_import {
    name: "Session",
    apk: "session/session-1.28.0-arm64-v8a-play-release.apk",
    privileged: false,
    certificate: "platform",
    dex_preopt: {
        enabled: false,
    },
}